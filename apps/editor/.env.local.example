# ============================================================
# apps/editor — Local Development Environment
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# For Railway production setup, see .env.railway.example
# ============================================================

# --- AI Gateway / LLM ---
# AI_GATEWAY_API_KEY=vck_...
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# Eve chat model modes (Lite/Pro/Expert). Comma-separated: the first model is
# primary, any extra ones are fallbacks the AI Gateway retries in order if the
# primary model call fails. Defaults below are used when unset.
# LITE_MODEL=deepseek/deepseek-v4-flash,openai/gpt-4o-mini
# PRO_MODEL=openai/gpt-5.6-luna
# EXPERT_MODEL=moonshotai/kimi-k3

# --- Clerk Auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where unauthenticated users are sent (the web app's sign-in page)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://localhost:3000/sign-in

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/latex_editor

# --- Editor ---
NEXT_PUBLIC_EDITOR_URL=http://localhost:3002

# Web app URL (dashboard lives here, not in the editor)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# --- Compiler ---
# Use "upload" to force using the Docker compiler container locally
# Use "local" to compile directly from filesystem (no Docker needed)
COMPILER_MODE=upload
# Shared secret between editor and compiler service (compiler rejects requests without it)
COMPILER_SECRET=generate-a-long-random-string

# --- S3 Storage (Local — RustFS via Docker) ---
# Start RustFS with: docker compose up rustfs
# For Railway production env vars, see .env.railway.example
STORAGE_PROVIDER=s3
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=latex-editor
AWS_REGION=us-east-1
S3_FORCE_PATH_STYLE=true   # Required for local RustFS/MinIO (path-style). Set to false for Railway Object Storage.
