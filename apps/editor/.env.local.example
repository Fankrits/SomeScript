# ============================================================
# apps/editor — Local Development Environment
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# For Railway production setup, see .env.railway.example
# ============================================================

# --- AI Gateway / LLM ---
# AI_GATEWAY_API_KEY=vck_...
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# Eve chat model modes (Lite/Pro/Expert). Comma-separated: the first model is
# primary, any extra ones are fallbacks the AI Gateway retries in order if the
# primary model call fails. Defaults below are used when unset.
# LITE_MODEL=deepseek/deepseek-v4-flash,openai/gpt-4o-mini
# PRO_MODEL=openai/gpt-5.6-luna
# EXPERT_MODEL=moonshotai/kimi-k3

# --- Clerk Auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where unauthenticated users are sent (the web app's sign-in page)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://localhost:3000/sign-in

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/latex_editor

# --- Editor ---
NEXT_PUBLIC_EDITOR_URL=http://localhost:3002

# Web app URL (dashboard lives here, not in the editor)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# --- Compiler ---
# Use "upload" to force using the Docker compiler container locally
# Use "local" to compile directly from filesystem (no Docker needed)
COMPILER_MODE=upload
# Shared secret between editor and compiler service (compiler rejects requests without it)
COMPILER_SECRET=generate-a-long-random-string

# --- S3 Storage (Local — RustFS via Docker) ---
# Start RustFS with: docker compose up rustfs
# For Railway production env vars, see .env.railway.example
STORAGE_PROVIDER=s3
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=latex-editor
AWS_REGION=us-east-1
S3_FORCE_PATH_STYLE=true   # Required for local RustFS/MinIO (path-style). Set to false for Railway Object Storage.

# Distributed Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# --- Real-time Collaboration (Yjs/Hocuspocus — apps/collaboration) ---
# Off by default. Start the service with: docker compose up collaboration
# NEXT_PUBLIC_COLLAB_ENABLED=true
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# Lets Eve's tools and /api/files push an out-of-band file write into an
# already-open collaboration room (POST {COLLAB_HTTP_URL}/apply) instead of
# a peer's editor silently going stale until the room reloads. Same host as
# NEXT_PUBLIC_COLLAB_WS_URL above but plain http(s), and COLLAB_INTERNAL_SECRET
# must match the collaboration service's own copy (see apps/collaboration —
# same shared-secret pattern as COMPILER_SECRET above).
COLLAB_HTTP_URL=http://localhost:1234
COLLAB_INTERNAL_SECRET=generate-a-long-random-string


# --- Microsoft Clarity (optional — session recordings, heatmaps, behavioral analytics) ---
# NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id


# --- Eve chat observability (optional) ---
# One switch for chat CONTENT capture across both surfaces:
#   - eve's local trace spool (.eve/traces) — prompts, replies, tool payloads,
#     readable with `bun x eve traces <sessionId> --verbose`
#   - the server transcript in agent/hooks/transcript.ts, which logs the user's
#     text and the assistant's reply as JSON (one line per event, `tag`:
#     "eve.transcript") to the dev log / Vercel Runtime Logs
#
# Left unset (the default) both record content. Set it to `off` and ids, event
# types, token usage and failure codes are still recorded, but no message text.
#
# Content capture means users' unpublished LaTeX enters log retention — a
# privacy-policy disclosure item, and the reason this knob exists.
# EVE_TRACES_CONTENT=off
