{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-perf",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y",
    "nextjs",
    "promise",
    "jest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    // Next.js apps use the automatic JSX runtime, and CSS/global side-effect
    // imports are never meant to be assigned to a variable.
    "import/no-unassigned-import": "off",
    // False positive: oxc-resolver doesn't follow @sentry/nextjs's re-export
    // chain for some named exports that do exist.
    "import/namespace": "off",
    // This codebase composes Base UI / Radix headless primitives, which use
    // role="..." on generic wrapper elements by design (not raw hand markup).
    "jsx-a11y/prefer-tag-over-role": "off",
    // Upstream typing gap: yjs's Y.Text has a real toString() at runtime
    // (src/types/YText.js) that its shipped .d.ts doesn't declare, so every
    // `${ytext}` interpolation looks unsafe to the type checker but isn't.
    "typescript/no-base-to-string": "off",
    // Remaining pre-existing debt with no single clean fix — each needs real
    // per-call-site judgment. Left visible as warnings rather than blind-fixed
    // or silenced.
    "typescript/no-unsafe-type-assertion": "warn",
    // Disagrees with real tsc on components/assistant-ui/eve-tool-calls.tsx:332 —
    // tsc requires that assertion (removing it breaks 14 call sites), oxlint's
    // type-aware checker says it's unnecessary. Trusting tsc; warn, don't auto-fix.
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/consistent-return": "warn",
    "typescript/restrict-template-expressions": "warn",
    // Terminal .then()/.catch() callbacks with nothing further chained off them —
    // this rule wants an explicit return even when there's nothing to return.
    "promise/always-return": "warn",
    // autoFocus on rename/search/composer inputs is deliberate UX (see
    // oxlint-fix-suggestions-unreliable memory: a previous auto-fix pass
    // stripped these and broke it before this was caught and reverted).
    "jsx-a11y/no-autofocus": "warn",
    // 5 of 6 are blob:/data: URIs (attachment/generated-image previews) that
    // next/image can't optimize anyway; the 6th is a remote SVG logo that
    // needs next.config.ts's dangerouslyAllowSVG (a real security tradeoff,
    // not a lint fix to make unilaterally).
    "nextjs/no-img-element": "warn",
    // Same Record<string, boolean>-vs-undefined trap as the "==="/"!"
    // auto-fix that broke search-panel.tsx's "Expand All" during rollout
    // (see oxlint-fix-suggestions-unreliable memory) — verify per instance.
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    // The 2 remaining are deliberate: BranchPicker (CLAUDE.md says never
    // re-add it — assistant-ui branching isn't supported) and saveStatus
    // (real state, actively set, but no "Saving…/Saved" UI consumes it yet —
    // a product gap to flag, not invent a design for here).
    "no-unused-vars": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    ".eve/**",
    ".workflow-data/**",
    ".output/**",
    "**/.next/**"
  ]
}
