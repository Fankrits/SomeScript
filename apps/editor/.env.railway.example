# ============================================================
# Railway Object Storage — Environment Variables
# ============================================================
# Paste these into your Railway editor service environment.
# Railway auto-injects Object Storage credentials when you link
# the bucket to the service — you can use variable references
# (shown below) instead of hardcoding values.
#
# HOW TO SET UP:
# 1. In Railway dashboard → your project → New → Object Storage
# 2. Select the bucket, then go to your editor service → Variables
# 3. Add the variables below, using ${{Object Storage.VAR_NAME}}
#    to reference the auto-injected bucket credentials.
# ============================================================

# --- Storage Provider ---
STORAGE_PROVIDER=s3

# --- Railway Object Storage Credentials ---
# Use Railway variable references to auto-populate from the linked bucket:
AWS_ENDPOINT=${{Object Storage.AWS_ENDPOINT_URL_S3}}
AWS_ACCESS_KEY_ID=${{Object Storage.AWS_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{Object Storage.AWS_SECRET_ACCESS_KEY}}
AWS_BUCKET_NAME=${{Object Storage.BUCKET_NAME}}

# Railway Object Storage uses "auto" region (Tigris-managed)
AWS_REGION=auto

# IMPORTANT: Railway Object Storage uses virtual-hosted style (NOT path style)
# Leave this unset or set to false — do NOT set to true
# S3_FORCE_PATH_STYLE=false   ← omit this line entirely (defaults to false)

# ============================================================
# Other Required Variables (copy from your local .env.local)
# ============================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Editor runs on its own domain in prod → configure it as a Clerk satellite domain
# (Clerk Dashboard → Domains → add satellite). Primary domain is the web app.
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_DOMAIN=your-editor.up.railway.app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://your-web-app.example.com/sign-in

DATABASE_URL=postgresql://...   # your Railway Postgres URL

NEXT_PUBLIC_EDITOR_URL=https://your-editor.up.railway.app

# Compiler service internal URL (Railway private networking)
COMPILER_URL=http://compiler.railway.internal:3001

# Always use "upload" mode in production (no local filesystem access)
COMPILER_MODE=upload
