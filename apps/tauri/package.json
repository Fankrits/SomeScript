{
  "name": "somescript-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:public": "bun scripts/sync-public.mjs",
    "web:dev": "bun run sync:public && vite",
    "web:build": "bun run sync:public && tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:sidecars": "sh scripts/fetch-sidecars.sh",
    "desktop:sidecars:universal": "sh scripts/fetch-sidecars.sh universal",
    "desktop:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "desktop:build:universal": "tauri build --config src-tauri/tauri.bundle.conf.json --target universal-apple-darwin",
    "desktop:build:linux": "tauri build --config src-tauri/tauri.bundle.linux.conf.json",
    "desktop:verify": "sh scripts/verify-bundle.sh src-tauri/target/release/bundle/macos/SomeScript.app",
    "desktop:smoke": "sh scripts/smoke-bundle.sh src-tauri/target/release/bundle/macos/SomeScript.app",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:dev": "playwright test --config e2e/playwright.dev.config.ts",
    "e2e:webkit": "playwright test --config e2e/playwright.webkit.config.ts",
    "e2e:webview2": "playwright test --config e2e/webview2/playwright.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2",
    "core-js": "^3.50.0",
    "lucide-react": "^1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.0.16"
  }
}
