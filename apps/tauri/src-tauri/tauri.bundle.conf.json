{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "category": "Productivity",
    "shortDescription": "Free, local LaTeX editor",
    "longDescription": "Write, compile and preview LaTeX documents on your own computer. No account, no cloud.",
    "externalBin": ["binaries/tectonic", "binaries/synctex"],
    "resources": ["templates/**/*", "THIRD_PARTY_LICENSES.md", "binaries/SOURCES.txt"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
