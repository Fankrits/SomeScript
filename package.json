{
  "name": "latex-workspace",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "PATH=\"$HOME/.vite-plus/bin:$PATH\" turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  },
  "overrides": {
    "@codemirror/view": "6.43.15",
    "@codemirror/state": "6.7.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@hono/node-server": "^2.1.8",
    "@vue/server-renderer": "^3.5.45",
    "browserslist": "^4.29.5",
    "devalue": "^5.9.4",
    "dompurify": "^3.4.17",
    "esbuild": "^0.25.12",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.18",
    "ip-address": "^10.7.6",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.1",
    "linkify-it": "^5.0.2",
    "postcss": "^8.5.32",
    "prosemirror-view": "^1.42.9",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "sharp": "^0.35.5",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.23",
    "undici": "^8.12.4"
  }
}
