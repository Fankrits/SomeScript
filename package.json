{
  "name": "latex-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "PATH=\"$HOME/.vite-plus/bin:$PATH\" turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  },
  "overrides": {
    "@codemirror/view": "6.43.8"
  }
}
